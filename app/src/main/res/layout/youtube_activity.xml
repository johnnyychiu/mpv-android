<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/youtube_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/youtube_background" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="10dp" android:src="@drawable/youtube_ic_logo" android:contentDescription="@string/youtube_brand_accessibility" />
        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <com.google.android.material.tabs.TabLayout android:id="@+id/youtube_tabs" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="start|center_vertical" android:minHeight="48dp" android:background="@color/youtube_background" app:tabMode="fixed" app:tabGravity="fill" app:tabMinWidth="0dp" app:tabPaddingStart="4dp" app:tabPaddingEnd="4dp" app:tabTextAppearance="@style/YouTubeTabText" app:tabTextColor="@color/youtube_text_muted" app:tabSelectedTextColor="@color/youtube_text" app:tabIndicatorColor="@color/youtube_accent" app:tabIndicatorHeight="2dp" app:tabIndicatorFullWidth="false" app:tabRippleColor="@color/youtube_surface_raised" />
        </FrameLayout>
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/youtube_toolbar" android:layout_width="48dp" android:layout_height="wrap_content" android:minHeight="48dp" android:background="@color/youtube_background" app:contentInsetStart="0dp" app:contentInsetEnd="0dp" app:contentInsetEndWithActions="0dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/youtube_busy" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <com.google.android.material.progressindicator.LinearProgressIndicator android:layout_width="match_parent" android:layout_height="2dp" android:indeterminate="true" app:trackThickness="2dp" app:indicatorColor="@color/youtube_accent" app:trackColor="@color/youtube_surface" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:paddingStart="@dimen/youtube_screen_padding" android:paddingEnd="8dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/youtube_busy_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="13sp" android:textColor="@color/youtube_text_secondary" android:accessibilityLiveRegion="polite" android:maxLines="2" />
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/youtube_cancel" style="@style/YouTubeIconButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/youtube_ic_close" android:contentDescription="@string/youtube_cancel_operation" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/youtube_notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/youtube_screen_padding" android:layout_marginEnd="@dimen/youtube_screen_padding" android:layout_marginTop="8dp" android:paddingStart="12dp" android:background="@drawable/youtube_notice_background" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/youtube_ic_info" android:importantForAccessibility="no" />
        <TextView android:id="@+id/youtube_notice_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:gravity="center_vertical" android:layout_marginStart="10dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:textSize="13sp" android:textColor="@color/youtube_text_secondary" android:maxLines="2" android:ellipsize="end" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:accessibilityLiveRegion="polite" />
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/youtube_notice_close" style="@style/YouTubeIconButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/youtube_ic_close" android:contentDescription="@string/youtube_dismiss_notice" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/youtube_playlists_button" style="@style/YouTubeCompactButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="@dimen/youtube_screen_padding" android:text="@string/youtube_playlists" app:icon="@drawable/youtube_ic_library" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/youtube_content" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:overScrollMode="ifContentScrolls" />
        <ScrollView android:id="@+id/youtube_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:overScrollMode="never" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingStart="32dp" android:paddingEnd="32dp" android:paddingTop="32dp" android:paddingBottom="48dp">
                <ImageView android:id="@+id/youtube_empty_icon" android:layout_width="88dp" android:layout_height="88dp" android:padding="22dp" android:background="@drawable/youtube_empty_background" android:src="@drawable/youtube_ic_library" android:importantForAccessibility="no" />
                <TextView android:id="@+id/youtube_empty_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="@string/youtube_empty_headline" android:textSize="25sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:letterSpacing="-0.02" android:textColor="@color/youtube_text" />
                <TextView android:id="@+id/youtube_empty_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:maxWidth="320dp" android:text="@string/youtube_empty_copy" android:textSize="14sp" android:includeFontPadding="false" android:textColor="@color/youtube_text_secondary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/youtube_empty_action" style="@style/YouTubePrimaryButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="16dp" android:text="@string/youtube_add_channel" app:icon="@drawable/youtube_ic_add" />
                <com.google.android.material.button.MaterialButton android:id="@+id/youtube_empty_link" style="@style/YouTubeSecondaryButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="4dp" android:text="@string/youtube_open_video" app:icon="@drawable/youtube_ic_link" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
